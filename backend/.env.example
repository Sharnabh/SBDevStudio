# Supabase Database URL
# For direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For Supabase Transaction Pooler (port 6543, recommended on Render):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sbdevstudio

# JWT Secret
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Resend Mailer
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=SB Dev Studio <support@sbdevstudio.in>
NOTIFY_TO=sbdevstudio1@gmail.com

# Optional Local Upload Directory (defaults to backend/uploads)
UPLOAD_DIR=

